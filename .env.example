# Copy to .env (gitignored) for local development. No value is ever committed.
# The server reads this file for whatever the environment leaves unset.

# Where the server listens. The defaults suit local development.
HOST=127.0.0.1
PORT=8806
# The SQLite file. Empty means data/brief-board.sqlite under the repo root.
BRIEF_BOARD_DB=

# The board's own origin as the browser sees it. Empty means the Vite dev
# server, http://localhost:5178. For `npm start` (the built board on the
# server's own port) set it to http://127.0.0.1:8806, or signing in is refused.
PUBLIC_ORIGIN=
# The API prefix and the board's base path as the browser sees them. These are the defaults.
# BRIEF_BOARD_API_PREFIX=/brief-board-api
# BRIEF_BOARD_BASE=/brief-board/

# SECRET. The CLI's shared token: `openssl rand -base64 32`. The same value goes
# in ~/.config/brief-board/env for the CLI, never in a repo's .env. Empty shuts
# the CLI out; only a signed-in browser reads the board.
BRIEF_BOARD_TOKEN=

# Peers besides loopback whose X-Forwarded-For the login lockout believes:
# comma-separated addresses or CIDR ranges. Empty is right locally.
AUTH_TRUSTED_PROXIES=

# The one local user, made by `npm run seed -w @brief-board/server`, which asks
# on the terminal for whatever is empty here. An existing user is left as it is.
SEED_USERNAME=
SEED_PASSWORD=

# "Sign in with Ward" (optional): Ward's local seed writes these five. With
# WARD_OIDC_ISSUER empty the server runs with local accounts only.
# WARD_OIDC_CLIENT_KEY is a SECRET.
WARD_OIDC_ISSUER=
WARD_OIDC_CLIENT_ID=
WARD_OIDC_CLIENT_KEY=
WARD_OIDC_REDIRECT_URI=
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=
